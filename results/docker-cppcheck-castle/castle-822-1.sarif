        {
          "ruleId": "invalidScanfArgType_int",
          "level": "warning",
          "message": {
            "text": "%d in format string (no. 1) requires 'int *' but the argument type is 'signed int'."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "CASTLE-822-1.c"
                },
                "region": {
                  "startLine": 13
                }
              }
            }
          ]
        },
        {
          "ruleId": "memleak",
          "level": "error",
          "message": {
