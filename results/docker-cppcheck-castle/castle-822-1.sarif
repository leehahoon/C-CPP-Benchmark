{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "invalidScanfArgType_int",
              "name": "invalidScanfArgType_int"
            },
            {
              "id": "memleak",
              "name": "memleak"
            },
