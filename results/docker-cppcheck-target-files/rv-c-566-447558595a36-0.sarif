          "ruleId": "invalidPrintfArgType_sint",
          "level": "warning",
          "message": {
            "text": "%d in format string (no. 2) requires 'int' but the argument type is 'unsigned int'."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/softmagic.c"
                },
                "region": {
                  "startLine": 1040
                }
              }
            }
          ]
        },
        {
          "ruleId": "invalidPrintfArgType_uint",
