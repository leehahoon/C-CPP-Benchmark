{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "ignoredReturnValue",
              "name": "ignoredReturnValue"
            },
            {
              "id": "invalidPrintfArgType_uint",
              "name": "invalidPrintfArgType_uint"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ignoredReturnValue",
          "level": "warning",
          "message": {
            "text": "Return value of function log() is not used."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
