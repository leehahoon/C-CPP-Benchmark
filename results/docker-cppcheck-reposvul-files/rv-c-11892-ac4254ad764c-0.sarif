{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "unknownMacro",
              "name": "unknownMacro"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "unknownMacro",
          "level": "error",
          "message": {
            "text": "There is an unknown macro here somewhere. Configuration is required. If PHP_VERSION is a macro then please configure it."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "ext/soap/php_http.c"
                },
                "region": {
                  "startLine": 614
                }
              }
            }
          ]
        }
      ]
    }
  ]
}