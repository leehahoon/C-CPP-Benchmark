{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "memleak",
              "name": "memleak"
            },
            {
              "id": "nullPointerRedundantCheck",
              "name": "nullPointerRedundantCheck"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "memleak",
          "level": "error",
          "message": {
            "text": "Memory leak: out.value"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/gss_names.c"
                },
                "region": {
                  "startLine": 707
                }
              }
            }
          ]
        },
        {
          "ruleId": "nullPointerRedundantCheck",
          "level": "warning",
          "message": {
            "text": "Either the condition 'pw' is redundant or there is possible null pointer dereference: pw."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/gss_names.c"
                },
                "region": {
                  "startLine": 252
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/gss_names.c"
                },
                "region": {
                  "startLine": 249
                }
              }
            }
          ]
        }
      ]
    }
  ]
}