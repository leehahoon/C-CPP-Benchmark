{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "memleak",
              "name": "memleak"
            },
            {
              "id": "uninitvar",
              "name": "uninitvar"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "memleak",
          "level": "error",
          "message": {
            "text": "Memory leak: handler_item"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "libndp/libndp.c"
                },
                "region": {
                  "startLine": 1830
                }
              }
            }
          ]
        },
        {
          "ruleId": "uninitvar",
          "level": "error",
          "message": {
            "text": "Uninitialized variable: handler_item->msg_type"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "libndp/libndp.c"
                },
                "region": {
                  "startLine": 1780
                }
              }
            }
          ]
        }
      ]
    }
  ]
}