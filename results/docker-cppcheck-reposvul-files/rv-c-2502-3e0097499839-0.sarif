{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "nullPointerRedundantCheck",
              "name": "nullPointerRedundantCheck"
            },
            {
              "id": "uninitvar",
              "name": "uninitvar"
            },
            {
              "id": "toomanyconfigs",
              "name": "toomanyconfigs"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "nullPointerRedundantCheck",
          "level": "warning",
          "message": {
            "text": "Either the condition '!srp' is redundant or there is possible null pointer dereference: srp."
          },
          "locations": [
