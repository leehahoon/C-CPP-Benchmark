{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "uselessAssignmentPtrArg",
              "name": "uselessAssignmentPtrArg"
            },
            {
              "id": "invalidPrintfArgType_sint",
              "name": "invalidPrintfArgType_sint"
            },
            {
              "id": "toomanyconfigs",
              "name": "toomanyconfigs"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "uselessAssignmentPtrArg",
          "level": "warning",
          "message": {
            "text": "Assignment of function parameter has no effect outside the function. Did you forget dereferencing it?"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "util.c"
                },
                "region": {
                  "startLine": 234
                }
              }
            }
          ]
        },
        {
          "ruleId": "invalidPrintfArgType_sint",
          "level": "warning",
          "message": {
            "text": "%d in format string (no. 1) requires 'int' but the argument type is 'unsigned int'."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "util.c"
                },
                "region": {
                  "startLine": 478
                }
              }
            }
          ]
        }
      ]
    }
  ]
}