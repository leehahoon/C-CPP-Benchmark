{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "oppositeInnerCondition",
              "name": "oppositeInnerCondition"
            },
            {
              "id": "memleakOnRealloc",
              "name": "memleakOnRealloc"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "oppositeInnerCondition",
          "level": "warning",
          "message": {
            "text": "Opposite inner 'if' condition leads to a dead code block."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/hv/hv_kvp_daemon.c"
                },
                "region": {
                  "startLine": 324
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/hv/hv_kvp_daemon.c"
                },
                "region": {
                  "startLine": 317
                }
              }
            }
          ]
        },
        {
          "ruleId": "memleakOnRealloc",
          "level": "error",
          "message": {
            "text": "Common realloc mistake: 'record' nulled but not freed upon failure"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/hv/hv_kvp_daemon.c"
                },
                "region": {
                  "startLine": 281
                }
              }
            }
          ]
        },
        {
          "ruleId": "memleakOnRealloc",
          "level": "error",
          "message": {
            "text": "Common realloc mistake: 'record' nulled but not freed upon failure"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/hv/hv_kvp_daemon.c"
                },
                "region": {
                  "startLine": 383
                }
              }
            }
          ]
        }
      ]
    }
  ]
}