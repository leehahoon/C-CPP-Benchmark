{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "autoVariables",
              "name": "autoVariables"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "autoVariables",
          "level": "error",
          "message": {
            "text": "Address of local auto-variable assigned to a function parameter."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "fs/binfmt_script.c"
                },
                "region": {
                  "startLine": 83
                }
              }
            }
          ]
        }
      ]
    }
  ]
}