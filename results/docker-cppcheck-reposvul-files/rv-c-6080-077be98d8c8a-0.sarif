{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "ignoredReturnValue",
              "name": "ignoredReturnValue"
            },
            {
              "id": "memleakOnRealloc",
              "name": "memleakOnRealloc"
            },
            {
              "id": "toomanyconfigs",
              "name": "toomanyconfigs"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ignoredReturnValue",
          "level": "warning",
          "message": {
            "text": "Return value of function localtime() is not used."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "postsrsd.c"
                },
                "region": {
                  "startLine": 555
                }
              }
            }
          ]
        },
        {
          "ruleId": "memleakOnRealloc",
          "level": "error",
          "message": {
            "text": "Common realloc mistake: 'excludes' nulled but not freed upon failure"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "postsrsd.c"
                },
                "region": {
                  "startLine": 413
                }
              }
            }
          ]
        },
        {
          "ruleId": "memleakOnRealloc",
          "level": "error",
          "message": {
            "text": "Common realloc mistake: 'excludes' nulled but not freed upon failure"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "postsrsd.c"
                },
                "region": {
                  "startLine": 458
                }
              }
            }
          ]
        }
      ]
    }
  ]
}