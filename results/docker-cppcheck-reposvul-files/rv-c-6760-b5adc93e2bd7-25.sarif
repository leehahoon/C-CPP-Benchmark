{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "syntaxError",
              "name": "syntaxError"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "syntaxError",
          "level": "error",
          "message": {
            "text": "Code 'classSecureSocket:' is invalid C code. Use --std or --language to configure the language."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/lib/net/SecureSocket.h"
                },
                "region": {
                  "startLine": 35
                }
              }
            }
          ]
        }
      ]
    }
  ]
}