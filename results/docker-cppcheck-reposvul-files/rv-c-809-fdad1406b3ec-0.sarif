{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "preprocessorErrorDirective",
              "name": "preprocessorErrorDirective"
            },
            {
              "id": "toomanyconfigs",
              "name": "toomanyconfigs"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "preprocessorErrorDirective",
          "level": "error",
          "message": {
            "text": "#error Need zlib version 1.2.3 or later"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "pigz.c"
                },
                "region": {
                  "startLine": 358
                }
              }
            }
          ]
        }
      ]
    }
  ]
}