{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "nullPointerRedundantCheck",
              "name": "nullPointerRedundantCheck"
            },
            {
              "id": "uninitvar",
              "name": "uninitvar"
            }
          ]
        }
      },
