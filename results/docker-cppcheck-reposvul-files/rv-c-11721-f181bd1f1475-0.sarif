{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "invalidscanf",
              "name": "invalidscanf"
            },
            {
              "id": "resourceLeak",
              "name": "resourceLeak"
            },
            {
              "id": "literalWithCharPtrCompare",
              "name": "literalWithCharPtrCompare"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "invalidscanf",
          "level": "warning",
          "message": {
            "text": "fscanf() without field width limits can crash with huge input data."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "cpdb/cpdb-frontend.c"
                },
                "region": {
                  "startLine": 394
                }
              }
            }
          ]
        },
        {
          "ruleId": "resourceLeak",
          "level": "error",
          "message": {
            "text": "Resource leak: fp"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "cpdb/cpdb-frontend.c"
                },
                "region": {
                  "startLine": 1219
                }
              }
            }
          ]
        },
        {
          "ruleId": "literalWithCharPtrCompare",
          "level": "warning",
          "message": {
            "text": "String literal compared with variable 'jobid'. Did you intend to use strcmp() instead?"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "cpdb/cpdb-frontend.c"
                },
                "region": {
                  "startLine": 1081
                }
              }
            }
          ]
        }
      ]
    }
  ]
}