{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "arrayIndexOutOfBounds",
              "name": "arrayIndexOutOfBounds"
            },
            {
              "id": "toomanyconfigs",
              "name": "toomanyconfigs"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "arrayIndexOutOfBounds",
          "level": "error",
          "message": {
            "text": "Array 'winchoices[1]' accessed at index 1, which is out of bounds."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/windows.c"
                },
                "region": {
                  "startLine": 275
                }
              }
            }
          ]
        }
      ]
    }
  ]
}