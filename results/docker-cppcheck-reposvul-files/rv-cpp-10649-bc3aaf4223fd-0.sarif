{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "ignoredReturnValue",
              "name": "ignoredReturnValue"
            },
            {
              "id": "toomanyconfigs",
              "name": "toomanyconfigs"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ignoredReturnValue",
          "level": "warning",
          "message": {
            "text": "Return value of function buf->open() is not used."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/libraw_datastream.cpp"
                },
                "region": {
                  "startLine": 190
                }
              }
            }
          ]
        }
      ]
    }
  ]
}