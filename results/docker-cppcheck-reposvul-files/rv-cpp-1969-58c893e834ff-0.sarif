{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "arrayIndexOutOfBounds",
              "name": "arrayIndexOutOfBounds"
            },
            {
              "id": "uninitMemberVar",
              "name": "uninitMemberVar"
            },
            {
              "id": "noCopyConstructor",
              "name": "noCopyConstructor"
            },
            {
              "id": "noOperatorEq",
              "name": "noOperatorEq"
            },
            {
              "id": "toomanyconfigs",
              "name": "toomanyconfigs"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "arrayIndexOutOfBounds",
          "level": "error",
          "message": {
            "text": "Array 'header.payload[512]' accessed at index 4294967284, which is out of bounds."
          },
          "locations": [
            {
              "physicalLocation": {
