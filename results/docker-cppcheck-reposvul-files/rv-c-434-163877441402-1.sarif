{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "va_end_missing",
              "name": "va_end_missing"
            },
            {
              "id": "toomanyconfigs",
              "name": "toomanyconfigs"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "va_end_missing",
          "level": "error",
          "message": {
            "text": "va_list 'ap' was opened but not closed by va_end()."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/internal.c"
                },
                "region": {
                  "startLine": 55
                }
              }
            }
          ]
        }
      ]
    }
  ]
}