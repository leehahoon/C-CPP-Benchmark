{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "memleak",
              "name": "memleak"
            },
            {
              "id": "toomanyconfigs",
              "name": "toomanyconfigs"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "memleak",
          "level": "error",
          "message": {
            "text": "Memory leak: strtime"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/plugins/kdb/ldap/libkdb_ldap/ldap_principal2.c"
                },
                "region": {
                  "startLine": 1744
                }
              }
            }
          ]
        }
      ]
    }
  ]
}