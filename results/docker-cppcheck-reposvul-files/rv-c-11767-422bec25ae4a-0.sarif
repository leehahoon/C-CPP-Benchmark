{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "uselessAssignmentPtrArg",
              "name": "uselessAssignmentPtrArg"
            },
            {
              "id": "memleak",
              "name": "memleak"
            },
            {
              "id": "toomanyconfigs",
              "name": "toomanyconfigs"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "uselessAssignmentPtrArg",
          "level": "warning",
          "message": {
            "text": "Assignment of function parameter has no effect outside the function. Did you forget dereferencing it?"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "libcap/cap_alloc.c"
                },
                "region": {
                  "startLine": 301
                }
              }
            }
          ]
        },
        {
          "ruleId": "memleak",
          "level": "error",
          "message": {
            "text": "Memory leak: base"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "libcap/cap_alloc.c"
                },
                "region": {
                  "startLine": 171
                }
              }
            }
          ]
        }
      ]
    }
  ]
}