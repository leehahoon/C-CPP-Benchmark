{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "uselessAssignmentPtrArg",
              "name": "uselessAssignmentPtrArg"
            },
            {
              "id": "invalidPrintfArgType_uint",
              "name": "invalidPrintfArgType_uint"
            },
            {
              "id": "toomanyconfigs",
              "name": "toomanyconfigs"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "uselessAssignmentPtrArg",
          "level": "warning",
          "message": {
            "text": "Assignment of function parameter has no effect outside the function. Did you forget dereferencing it?"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "print-bgp.c"
                },
                "region": {
                  "startLine": 707
                }
              }
            }
          ]
        },
        {
          "ruleId": "invalidPrintfArgType_uint",
          "level": "warning",
          "message": {
            "text": "%u in format string (no. 1) requires 'unsigned int' but the argument type is 'signed int'."
          },
          "locations": [
            {
              "physicalLocation": {
