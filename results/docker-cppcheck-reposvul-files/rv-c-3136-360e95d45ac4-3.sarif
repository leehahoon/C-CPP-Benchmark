{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "unknownMacro",
              "name": "unknownMacro"
            },
            {
              "id": "toomanyconfigs",
              "name": "toomanyconfigs"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "unknownMacro",
          "level": "error",
          "message": {
            "text": "There is an unknown macro here somewhere. Configuration is required. If SC_FORMAT_LEN_SIZE_T is a macro then please configure it."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/libopensc/card-tcos.c"
                },
                "region": {
                  "startLine": 476
                }
              }
            }
          ]
        }
      ]
    }
  ]
}