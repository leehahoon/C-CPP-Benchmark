{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "allocaCalled",
              "name": "allocaCalled"
            },
            {
              "id": "nullPointerRedundantCheck",
              "name": "nullPointerRedundantCheck"
            },
            {
              "id": "nullPointerArithmeticRedundantCheck",
              "name": "nullPointerArithmeticRedundantCheck"
            },
            {
              "id": "toomanyconfigs",
