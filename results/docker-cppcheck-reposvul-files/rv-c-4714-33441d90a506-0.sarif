{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "nullPointer",
              "name": "nullPointer"
            },
            {
              "id": "ctunullpointer",
              "name": "ctunullpointer"
            },
            {
              "id": "toomanyconfigs",
              "name": "toomanyconfigs"
            }
          ]
        }
      },
      "results": [
        {
