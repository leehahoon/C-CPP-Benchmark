{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Cppcheck",
          "rules": [
            {
              "id": "uselessAssignmentPtrArg",
              "name": "uselessAssignmentPtrArg"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "uselessAssignmentPtrArg",
          "level": "warning",
          "message": {
            "text": "Assignment of function parameter has no effect outside the function. Did you forget dereferencing it?"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "drivers/net/wireless/marvell/mwifiex/uap_cmd.c"
                },
                "region": {
                  "startLine": 684
                }
              }
            }
          ]
        }
      ]
    }
  ]
}